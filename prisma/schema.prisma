generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  points              Int     @default(0)
  theme               String  @default("warrior")
  reminderEnabled     Boolean @default(false)
  reminderTime        String  @default("09:00")
  onboardingComplete  Boolean @default(false)
  heroClass           String?
  timezone            String  @default("UTC")
  createdAt           DateTime @default(now())

  accounts          Account[]
  sessions          Session[]
  goals             Goal[]
  userRewards       UserReward[]
  monthlyBudgets    MonthlyBudget[]
  expenses          Expense[]
  weightEntries     WeightEntry[]
  habits            Habit[]
  pushSubscriptions PushSubscription[]
  mealLogs          MealLog[]
  categoryBudgets   CategoryBudget[]
  dailyChallenges   UserDailyChallenge[]
  questCheckIns     QuestCheckIn[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6366f1")
  icon  String @default("target")
  goals Goal[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  goals GoalTag[]
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("active") // active | completed | archived
  priority    String    @default("medium") // low | medium | high
  progress    Int       @default(0) // 0-100
  targetDate  DateTime?
  completedAt DateTime?
  points      Int       @default(10)
  userId      String
  categoryId  String?
  guideType    String?   // "finance" | "weight" | "habits"
  guideTarget  Float?
  guideStart   Float?
  reminderTime      String?   // "HH:MM" e.g. "09:00"
  reminderFrequency String?   // "daily" | "weekly" | "monthly" | "custom"
  reminderDay       Int?      // weekly: 0-6 (Sun=0), monthly: 1-31
  reminderDays      String?   // custom: comma-separated weekdays e.g. "1,3,5"
  isRecurring       Boolean   @default(false)
  recurrenceType    String?   // "weekly" | "monthly"
  dailyCheckIn      Boolean   @default(false)
  checkInXP         Int       @default(5)
  checkInDays       String?   // comma-separated weekdays e.g. "1,3,5" (null = every day)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id])
  milestones    Milestone[]
  tags          GoalTag[]
  expenses      Expense[]
  weightEntries WeightEntry[]
  habits        Habit[]
  checkIns      QuestCheckIn[]
}

model GoalTag {
  goalId String
  tagId  String

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([goalId, tagId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  goalId      String
  createdAt   DateTime  @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Reward {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String
  pointsCost  Int    @default(0)
  type        String // badge | milestone | streak

  userRewards UserReward[]
}

model UserReward {
  id       String   @id @default(cuid())
  userId   String
  rewardId String
  earnedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String
  month     String   // "2026-05"
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model CategoryBudget {
  id       String @id @default(cuid())
  userId   String
  month    String // "YYYY-MM"
  category String
  amount   Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, category])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  goalId      String?
  amount      Float
  category    String
  description String?
  merchant    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  isRecurring Boolean  @default(false)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  goalId    String?
  weight    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  goalId    String?
  name      String
  icon      String     @default("🔁")
  createdAt DateTime   @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  date    String // "YYYY-MM-DD"

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model MealLog {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  mealType  String   // breakfast | snack_am | lunch | snack_pm | dinner
  text      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id          String @id @default(cuid())
  title       String
  description String
  xp          Int    @default(10)
  type        String // complete_milestone | log_expense | check_habit | log_weight | log_meal

  completions UserDailyChallenge[]
}

model UserDailyChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  date        String    // "YYYY-MM-DD"
  completed   Boolean   @default(false)
  completedAt DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, date])
}

model QuestCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  date      String   // "YYYY-MM-DD"
  note      String?
  xpAwarded Int      @default(5)
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId, date])
}
