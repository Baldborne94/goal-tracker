generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  points              Int     @default(0)
  theme               String  @default("warrior")
  reminderEnabled     Boolean @default(false)
  reminderTime        String  @default("09:00")
  onboardingComplete  Boolean @default(false)
  heroClass           String?
  kcalGoal            Int?    @default(2000)
  timezone            String  @default("UTC")
  createdAt           DateTime @default(now())

  accounts          Account[]
  sessions          Session[]
  goals             Goal[]
  userRewards       UserReward[]
  monthlyBudgets    MonthlyBudget[]
  expenses          Expense[]
  weightEntries     WeightEntry[]
  habits            Habit[]
  pushSubscriptions PushSubscription[]
  mealLogs          MealLog[]
  categoryBudgets   CategoryBudget[]
  dailyChallenges   UserDailyChallenge[]
  questCheckIns     QuestCheckIn[]
  recurringBills    RecurringBill[]
  shoppingItems     ShoppingItem[]
  gymDays           GymDay[]
  gymExercises      GymExercise[]
  gymLogs           GymLog[]
  foodEntries       FoodEntry[]
  workoutSessions   WorkoutSession[]
  sleepLogs         SleepLog[]
  waterLogs         WaterLog[]
  bodyMeasurements  BodyMeasurement[]
  svuotaFrigoRecipes SvuotaFrigoRecipe[]
  aiUsage           AiUsage[]
  healthMetrics     HealthMetric[]
  loginTickets      LoginTicket[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6366f1")
  icon  String @default("target")
  goals Goal[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  goals GoalTag[]
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("active") // active | completed | archived
  priority    String    @default("medium") // low | medium | high
  progress    Int       @default(0) // 0-100
  targetDate  DateTime?
  completedAt DateTime?
  points      Int       @default(10)
  userId      String
  categoryId  String?
  guideType    String?   // "finance" | "weight" | "habits"
  guideTarget  Float?
  guideStart   Float?
  reminderTime      String?   // "HH:MM" e.g. "09:00"
  reminderFrequency String?   // "daily" | "weekly" | "monthly" | "custom"
  reminderDay       Int?      // weekly: 0-6 (Sun=0), monthly: 1-31
  reminderDays      String?   // custom: comma-separated weekdays e.g. "1,3,5"
  isRecurring       Boolean   @default(false)
  recurrenceType    String?   // "weekly" | "monthly"
  dailyCheckIn      Boolean   @default(false)
  checkInXP         Int       @default(5)
  checkInDays       String?   // comma-separated weekdays e.g. "1,3,5" (null = every day)
  healthMetric      String?   // e.g. "steps" — auto check-in when the day's total reaches healthTarget
  healthTarget      Float?    // e.g. 10000
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id])
  milestones    Milestone[]
  tags          GoalTag[]
  expenses      Expense[]
  weightEntries WeightEntry[]
  habits        Habit[]
  checkIns      QuestCheckIn[]
}

model GoalTag {
  goalId String
  tagId  String

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([goalId, tagId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  goalId      String
  createdAt   DateTime  @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Reward {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String
  pointsCost  Int    @default(0)
  type        String // badge | milestone | streak

  userRewards UserReward[]
}

model UserReward {
  id       String   @id @default(cuid())
  userId   String
  rewardId String
  earnedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String
  month     String   // "2026-05"
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model CategoryBudget {
  id       String @id @default(cuid())
  userId   String
  month    String // "YYYY-MM"
  category String
  amount   Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, category])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  goalId      String?
  amount      Float
  category    String
  description String?
  merchant    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  isRecurring Boolean  @default(false)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  goalId    String?
  weight    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  goalId    String?
  name      String
  icon      String     @default("🔁")
  createdAt DateTime   @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  date    String // "YYYY-MM-DD"

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model MealLog {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  mealType  String   // breakfast | snack_am | lunch | snack_pm | dinner
  text      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id          String @id @default(cuid())
  title       String
  description String
  xp          Int    @default(10)
  type        String // complete_milestone | log_expense | check_habit | log_weight | log_meal

  completions UserDailyChallenge[]
}

model UserDailyChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  date        String    // "YYYY-MM-DD"
  completed   Boolean   @default(false)
  completedAt DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, date])
}

model QuestCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  date      String   // "YYYY-MM-DD"
  note      String?
  xpAwarded Int      @default(5)
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId, date])
}

model RecurringBill {
  id               String   @id @default(cuid())
  userId           String
  title            String
  amount           Float
  dueDay           Int
  category         String
  notifyDaysBefore Int      @default(3)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShoppingItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  quantity  String?
  checked   Boolean  @default(false)
  category  String   @default("altro")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Palestra (gym program) ──────────────────────────────────────────────
// NOTE: these tables are created at runtime via raw SQL in src/lib/init-tables.ts
// (lazy CREATE TABLE IF NOT EXISTS). The models below mirror that schema for
// type-safety and documentation. Tables are NOT created via `prisma db push`
// (hangs on Supabase pgBouncer advisory locks) — see CLAUDE.md.

model GymDay {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String   @default("💪")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises GymExercise[]
  logs      GymLog[]
}

model GymExercise {
  id          String  @id @default(cuid())
  userId      String
  dayId       String
  name        String
  muscleGroup String
  sets        Int     @default(3)
  repsMin     Int?
  repsMax     Int?
  repsNote    String?
  restSec     Int?    @default(60)
  weightNote  String?
  order       Int     @default(0)

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day  GymDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model GymLog {
  id          String   @id @default(cuid())
  userId      String
  dayId       String
  date        String   // "YYYY-MM-DD"
  durationMin Int?
  notes       String?
  createdAt   DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     GymDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  entries GymSetEntry[]
}

model GymSetEntry {
  id         String @id @default(cuid())
  logId      String
  exerciseId String
  setNumber  Int
  reps       Int?
  weight     Float?

  log GymLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

// ── Dieta (diet log) ────────────────────────────────────────────────────

model FoodEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String   // "YYYY-MM-DD"
  mealType    String   // breakfast | snack_am | lunch | snack_pm | dinner
  foodName    String
  grams       Float
  kcalPer100g Float
  kcal        Float
  proteins    Float    @default(0)
  carbs       Float    @default(0)
  fat         Float    @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WaterLog {
  id      String @id @default(cuid())
  userId  String
  date    String // "YYYY-MM-DD"
  glasses Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ── Workout / cardio (kcal burned) ──────────────────────────────────────

model WorkoutSession {
  id         String   @id @default(cuid())
  userId     String
  date       String   // "YYYY-MM-DD"
  kcalBurned Int      @default(0)
  createdAt  DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@unique([userId, date])
}

model WorkoutExercise {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  name         String
  category     String   @default("Strength")
  exerciseType String   @default("strength")
  sets         Int?
  reps         Int?
  weightKg     Float?
  durationMin  Int?
  met          Float?
  kcalBurned   Int      @default(0)
  createdAt    DateTime @default(now())

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ── Sonno e misure corporee ─────────────────────────────────────────────

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  hours     Float
  quality   Int      @default(3)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD"
  height    Float?
  waist     Float?
  hips      Float?
  chest     Float?
  bicep     Float?
  bodyFat   Float?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Svuota Frigo (AI recipe suggestions) ────────────────────────────────

model SvuotaFrigoRecipe {
  id          String   @id @default(cuid())
  userId      String
  ingredients String   // JSON-encoded string[] of ingredient names
  content     String   // AI-generated recipe text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-user log of paid AI generations, used for daily rate limiting.
// See src/lib/rate-limit.ts.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   // e.g. "svuota-frigo"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endpoint, createdAt])
}

// ── Salute (Health Connect / Galaxy Fit3) ───────────────────────────────

// Deliberately generic so new wearable metrics need no migration: the metric
// name lives in `metricType` and anything structured (sleep stages, workout
// type, blood pressure pair) goes in `metadata`.
//
// Dedup: re-reading the same day from Health Connect must not duplicate rows.
// `externalId` is the Health Connect record id when the provider exposes one;
// when it doesn't, we fall back to a deterministic hash of
// (metricType, recordedAt, value, source). Either way the value lands in
// `dedupKey`, which is unique per user.
model HealthMetric {
  id         String   @id @default(cuid())
  userId     String
  metricType String // "steps" | "sleep" | "heartRate" | … see src/lib/health.ts
  value      Float
  unit       String // "count" | "minute" | "bpm" | "meter" | "kilocalorie" | …
  recordedAt DateTime
  date       String // "YYYY-MM-DD" in the user's local time, for cheap daily grouping
  source     String   @default("health_connect") // "health_connect" | "manual"
  sourceName String? // originating app, e.g. "Samsung Health"
  dedupKey   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, metricType, date])
  @@index([userId, metricType, recordedAt])
}

// Ticket monouso per il login Google dall'APK: traghettano la sessione dal
// browser di sistema (dove l'OAuth web funziona) alla WebView del guscio
// Android (dove il cookie deve nascere). Coniati da /api/mobile-auth/finish,
// spesi dal provider "ticket" di NextAuth; vita di 2 minuti, cancellati alla
// prima spesa. La chiave è l'hash SHA-256 del ticket, mai il valore in chiaro.
model LoginTicket {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
