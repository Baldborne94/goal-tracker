# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code agent worktrees
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production

# SQLite databases
*.db
*.db-shm
*.db-wal

# vercel
.vercel

# Capacitor — copie di public/ rigenerate da `npx cap sync android`.
# Il guscio carica la PWA da server.url, quindi a runtime non vengono nemmeno usate.
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
